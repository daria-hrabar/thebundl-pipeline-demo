# Required for live discovery
BRAVE_SEARCH_API_KEY=

# Required for AI extraction (Groq is the default provider)
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b

# Required for --publish. Use the dedicated test project only.
SUPABASE_URL=
SUPABASE_KEY=

# Optional overrides
DISCOVERY_INTERVAL_DAYS=14
COLLECTION_INTERVAL_HOURS=24
MAX_SEARCH_REQUESTS_PER_RUN=12
MAX_AI_REQUESTS_PER_RUN=24
AI_BUDGET_USD=1.00
# Conservative per-attempt upper bound for your model and bounded input/output.
AI_COST_PER_REQUEST_USD=0.05
BRAVE_SEARCH_BUDGET_USD=5.00
# Set to your search plan’s per-request charge (zero only for free requests).
BRAVE_SEARCH_COST_PER_REQUEST_USD=0.00
MAX_SOURCES_PER_RUN=20
WORK_DIR=work
