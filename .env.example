# Required for live discovery
BRAVE_SEARCH_API_KEY=

# Required for AI extraction (Groq is the default provider)
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b

# Required for --publish. Use the dedicated test project only.
SUPABASE_URL=
SUPABASE_KEY=

# Optional overrides
DISCOVERY_INTERVAL_DAYS=14
COLLECTION_INTERVAL_HOURS=24
MAX_SEARCH_REQUESTS_PER_RUN=12
MAX_AI_REQUESTS_PER_RUN=24
MAX_SOURCES_PER_RUN=20
WORK_DIR=work
